{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build TRM.CMD",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}\\TRM.CMD\\TRM.CMD.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build TRM.App",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}\\TRM.App\\TRM.App.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "test TRM.Tests (Fast)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}\\TRM.Tests\\TRM.Tests.csproj",
                "--settings",
                "${workspaceFolder}\\TRM.Tests\\fast.runsettings"
            ],
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "test TRM.Tests (LongRunning)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}\\TRM.Tests\\TRM.Tests.csproj",
                "--settings",
                "${workspaceFolder}\\TRM.Tests\\long-running.runsettings"
            ],
            "problemMatcher": "$msCompile",
            "group": "test"
        }
    ]
}
