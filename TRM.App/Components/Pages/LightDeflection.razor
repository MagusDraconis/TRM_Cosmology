@page "/light-deflection"
@using TRM.Core.WeakField
@inject IWeakFieldService WeakFieldService

<PageTitle>Light Deflection</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Light Deflection — TRM vs GR</MudText>

<MudGrid Spacing="2">
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4">
            <MudSelect T="WeakFieldBodyPreset" Label="Body" @bind-Value="_body">
                @foreach (var body in Enum.GetValues<WeakFieldBodyPreset>())
                {
                    <MudSelectItem T="WeakFieldBodyPreset" Value="@body">@body</MudSelectItem>
                }
            </MudSelect>

            <MudNumericField T="double" Label="Impact parameter multiplier" @bind-Value="_impactMultiplier" Min="0.25" Max="30" Step="0.1" />
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Recompute">Recompute</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ResetDefaults">Reset Defaults</MudButton>
            </MudStack>

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2">GR (Einstein)</MudText>
            <MudText Typo="Typo.body2">Δθ_GR = @_result.GrDeflectionArcSeconds.ToString("F4") arcsec</MudText>
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.subtitle2">TRM (this model)</MudText>
            <MudText Typo="Typo.body2">Δθ_TRM = @_result.TrmDeflectionArcSeconds.ToString("F4") arcsec</MudText>
            <MudText Typo="Typo.body2">Correction factor: @_result.TrmCorrectionFactor.ToString("F10")</MudText>

            <MudChip T="string" Color="@(Math.Abs(_result.DeltaTrmMinusGrArcSeconds) <= 1e-4 ? Color.Success : Color.Warning)" Variant="Variant.Filled" Class="mt-2">
                Δ(TRM - GR): @_result.DeltaTrmMinusGrArcSeconds.ToString("E4") arcsec
            </MudChip>

            <MudPaper Class="pa-3 mt-3" Outlined="true" Style="max-height: 80vh; overflow-y: auto;">
                <MudText Typo="Typo.subtitle2" GutterBottom="true">Physics Context</MudText>

                <div class="trm-formula-card">
                    <MudText Typo="Typo.caption">GR (Einstein, 1915) — weak-field analytical:</MudText>
                    <LatexDisplay Mode="LatexMode.Display" Content="$$\Delta\theta_{\text{GR}}=\frac{4GM}{c^2 b_{\text{impact}}}$$" />
                </div>

                <div class="trm-formula-card">
                    <MudText Typo="Typo.caption">TRM — effective photon index n_eff from transport:</MudText>
                    <LatexDisplay Mode="LatexMode.Display" Content="$$n_{\text{eff}}=2+\lambda_{\text{time}}\,\phi+\lambda_{\text{space}}\,\phi^2\,|\dot{\mu}|,\qquad\phi=\frac{GM}{r}$$" />
                </div>

                <div class="trm-formula-card">
                    <MudText Typo="Typo.caption">TRM deflection (weak-field approximation):</MudText>
                    <LatexDisplay Mode="LatexMode.Display" Content="$$\Delta\theta_{\text{TRM}}=\Delta\theta_{\text{GR}}\cdot f(\kappa,b),\qquad f(\kappa,b)\xrightarrow[\kappa\to0.3,\;b\to1.248]{}1$$" />
                </div>

                <div class="trm-formula-card">
                    <MudText Typo="Typo.caption">Solar baseline (TRM ≅ GR at limb):</MudText>
                    <LatexDisplay Mode="LatexMode.Display" Content="$$\Delta\theta_{\odot}\approx 1.75\;\text{arcsec}$$" />
                </div>

                <div class="trm-formula-card">
                    <MudText Typo="Typo.caption">Effective speed of light from n_eff:</MudText>
                    <LatexDisplay Mode="LatexMode.Display" Content="$$c_{\text{eff}}=\frac{c_0}{n_{\text{eff}}},\qquad n_{\text{eff}}=2+\lambda_{\text{time}}\phi+\lambda_{\text{space}}\phi^2|\dot{\mu}|$$" />
                </div>

                <MudText Typo="Typo.caption">Current: body=@_body, impact mult=@_impactMultiplier.ToString("F2"), Δθ_GR=@_result.GrDeflectionArcSeconds.ToString("F4")″, Δθ_TRM=@_result.TrmDeflectionArcSeconds.ToString("F4")″</MudText>
            </MudPaper>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Deflection vs Impact Parameter (TRM & GR)</MudText>
            <MudChart ChartType="ChartType.Line" ChartSeries="_series" XAxisLabels="_labels" Width="100%" Height="330px" />
        </MudPaper>

        <MudPaper Class="pa-4 mt-3" Outlined="true">
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" GutterBottom="true">Conclusions</MudText>
            <MudText Typo="Typo.body2">
                TRM light deflection is governed by the effective photon index
                <LatexDisplay Content="$n_{\text{eff}}=2+\lambda_{\text{time}}\phi+\lambda_{\text{space}}\phi^2|\dot{\mu}|$" />,
                which reduces to the GR value <LatexDisplay Content="$n=2$" /> in the weak-field limit.
                The resulting deflection
                <LatexDisplay Content="$\Delta\theta_{\text{TRM}}=\Delta\theta_{\text{GR}}\cdot f(\kappa,b)$" />
                recovers the classic Einstein result of <LatexDisplay Content="$1.75''$" /> at the solar
                limb when <LatexDisplay Content="$(\kappa,b)$" /> are at their optimized values. The full
                RK4 photon transport model provides a numerical framework for computing deflections in
                stronger fields where the analytical weak-field approximation breaks down.
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private const WeakFieldBodyPreset DefaultBody = WeakFieldBodyPreset.Sun;
    private const double DefaultImpactMultiplier = 1.0;

    private WeakFieldBodyPreset _body = DefaultBody;
    private double _impactMultiplier = DefaultImpactMultiplier;

    private LightDeflectionResult _result = new(0, 0, 0, 0, 0, 0, 0);
    private string[] _labels = [];
    private List<ChartSeries> _series = [];

    protected override void OnInitialized()
    {
        Recompute();
    }

    private void Recompute()
    {
        _result = WeakFieldService.ComputeLightDeflection(_body, _impactMultiplier);

        var multipliers = Enumerable.Range(1, 20).Select(i => i * 0.5).ToArray();
        var trmValues = multipliers
            .Select(m => WeakFieldService.ComputeLightDeflection(_body, m).TrmDeflectionArcSeconds)
            .ToArray();
        var grValues = multipliers
            .Select(m => WeakFieldService.ComputeLightDeflection(_body, m).GrDeflectionArcSeconds)
            .ToArray();

        _labels = multipliers.Select(m => m.ToString("F1")).ToArray();
        _series =
        [
            new ChartSeries { Name = "TRM Δθ (arcsec)", Data = trmValues, ShowDataMarkers= true },
            new ChartSeries { Name = "GR Δθ (arcsec)", Data = grValues }
        ];
    }

    private void ResetDefaults()
    {
        _body = DefaultBody;
        _impactMultiplier = DefaultImpactMultiplier;
        Recompute();
    }
}
