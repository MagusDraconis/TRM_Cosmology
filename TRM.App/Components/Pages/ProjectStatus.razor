@page "/project-status"
@using TRM.App.Services
@using TRM.App.Models
@inject TrmStatusService StatusService
@rendermode InteractiveServer

<PageTitle>Project Status</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else if (_status is null || _loadError)
{
    <MudPaper Class="pa-6 mt-4" Outlined="true" Style="background: var(--mud-palette-warning-hover, #FFF8E1); border-left: 4px solid var(--mud-palette-warning, #F57F17);">
        <MudStack Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Large" Color="Color.Warning" />
            <MudText Typo="Typo.h6" Color="Color.Warning">Status Data Unavailable</MudText>
            <MudText Typo="Typo.body1">Currently no project status data is available.</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">The status file could not be loaded. This may happen if the file is missing, malformed, or contains invalid data.</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Please verify that <code>wwwroot/data/trm-v*-status.json</code> files exist and are valid JSON.</MudText>
        </MudStack>
    </MudPaper>
}
else
{
    var s = _status;

<MudText Typo="Typo.h4" GutterBottom="true">TRM Project Status</MudText>
    <MudStack Row="true" Spacing="1" Class="mb-4" Justify="Justify.Center">
    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="GoFirst" Disabled="@(_firstDisabled)">⏮ First</MudButton>
    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="GoPrevious" Disabled="@(_prevDisabled)">◀ Back</MudButton>
    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@_currentVersionLabel</MudChip>
    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="GoNext" Disabled="@(_nextDisabled)">Forward ▶</MudButton>
    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="GoNewest" Disabled="@(_newestDisabled)">Newest ⏭</MudButton>
</MudStack>
<MudStack Row="true" Spacing="2" Class="mb-4" Justify="Justify.Center" Style="max-width: 600px; margin: 0 auto;">
    <MudText Typo="Typo.caption" Style="min-width: 48px; text-align: right;">@(StatusService.GetAvailableVersions().FirstOrDefault() ?? "v0")</MudText>
    <MudSlider Value="_sliderIndex" ValueChanged="@(async (int v) => { _sliderIndex = v; await OnSliderChanged(); })"
               Min="0" Max="@(_sliderMax)" Immediate="true"
               Variant="Variant.Outlined" Color="Color.Primary"
               Style="flex: 1;" />
    <MudText Typo="Typo.caption" Style="min-width: 48px;">@(StatusService.GetAvailableVersions().LastOrDefault() ?? "v?")</MudText>
</MudStack>
<MudText Typo="Typo.body1">Current status of the Temporal Rate Matrix (TRM) research program.</MudText>
<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4">Info: This page is updated nearly every day, and at least once every week.</MudText>

<MudPaper Class="pa-4 mb-4" Outlined="true" Style="background: var(--mud-palette-info-hover, #F0F7FF); border-left: 4px solid var(--mud-palette-info, #2196F3);">
    <MudStack Spacing="1">
        <MudText Typo="Typo.body2"><b>TRM is an exploratory research program.</b></MudText>
        <MudText Typo="Typo.body2">The project uses strict claim discipline:</MudText>
        <MudStack Row="true" Spacing="2" Class="mt-1">
            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">SUPPORTED</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">CONDITIONAL</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">HYPOTHESIS</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">NOT CLAIMED</MudChip>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-1">
            The project does <b>not</b> currently claim: derivation of physical c · derivation of physical G · replacement of General Relativity · derivation of quantum mechanics · derivation of Planck scales · derivation of D=3
        </MudText>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true">Status Overview</MudText>
    <MudGrid Spacing="2">
        <MudItem xs="6" sm="4" md="3" lg="2">
            <MudPaper Class="pa-3 text-center" Outlined="true">
                <MudText Typo="Typo.caption" Color="Color.Secondary">V3.4 Core</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">✅ Frozen</MudChip>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="3" lg="2">
            <MudPaper Class="pa-3 text-center" Outlined="true">
                <MudText Typo="Typo.caption" Color="Color.Secondary">V4 Interpretation</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">✅ Frozen</MudChip>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="3" lg="2">
            <MudPaper Class="pa-3 text-center" Outlined="true">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@(s.Phase ?? "V4")</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">✅ @(s.ReleaseStatus ?? "Active")</MudChip>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="3" lg="2">
            <MudPaper Class="pa-3 text-center" Outlined="true">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Test Status</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">✅ @s.TestSummary.Passed/@s.TestSummary.Total</MudChip>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="3" lg="2">
            <MudPaper Class="pa-3 text-center" Outlined="true">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Verification</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">✅ @s.TestSummary.Verification</MudChip>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudText Typo="Typo.h6" GutterBottom="true" Class="mt-2">Current Research Status</MudText>
<MudGrid Spacing="2">
    @foreach (var suite in s.Suites.Where(su => !string.IsNullOrEmpty(su.ClaimCategory)))
    {
        var color = suite.ClaimCategory switch { "SUPPORTED" => Color.Success, "CONDITIONAL" => Color.Warning, "HYPOTHESIS" => Color.Info, _ => Color.Default };
        <MudItem xs="12" md="6" lg="4">
            <MudCard Elevation="1" Class="trm-status-card">
                <MudCardContent>
                    <MudStack Spacing="1">
                        <MudChip T="string" Size="Size.Small" Color="@color" Variant="Variant.Filled">@suite.ClaimCategory</MudChip>
                        <MudText Typo="Typo.subtitle1"><b>@suite.Name</b></MudText>
                        <MudText Typo="Typo.body2">@GetSuiteDescription(suite.Name)</MudText>
                        @if (suite.Name.Contains("Quantum")) { <MudText Typo="Typo.caption" Color="Color.Secondary">⚠ This does <b>not</b> mean quantum mechanics is derived.</MudText> }
                        else if (suite.Name.Contains("Planck")) { <MudText Typo="Typo.caption" Color="Color.Secondary">⚠ Planck length and Planck time are <b>not</b> derived.</MudText> }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

<MudText Typo="Typo.h6" GutterBottom="true" Class="mt-4">Claim Discipline</MudText>
<MudGrid Spacing="2">
    <MudItem xs="12" md="6">
        <MudCard Elevation="1" Style="border-top: 4px solid var(--mud-palette-success, #2E7D32);">
            <MudCardContent>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="mb-2">SUPPORTED (@s.SupportedClaims.Count)</MudChip>
                <MudStack Spacing="0">
                    @foreach (var c in s.SupportedClaims) { <MudText Typo="Typo.body2">&bull; @c</MudText> }
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudCard Elevation="1" Style="border-top: 4px solid var(--mud-palette-warning, #F57F17);">
            <MudCardContent>
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Class="mb-2">CONDITIONAL (@s.ConditionalClaims.Count)</MudChip>
                <MudStack Spacing="0">
                    @foreach (var c in s.ConditionalClaims) { <MudText Typo="Typo.body2">&bull; @c</MudText> }
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudCard Elevation="1" Style="border-top: 4px solid var(--mud-palette-info, #2196F3);">
            <MudCardContent>
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="mb-2">HYPOTHESIS (@s.Hypotheses.Count)</MudChip>
                <MudStack Spacing="0">
                    @foreach (var c in s.Hypotheses) { <MudText Typo="Typo.body2">&bull; @c</MudText> }
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudCard Elevation="1" Style="border-top: 4px solid var(--mud-palette-error, #C62828);">
            <MudCardContent>
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Class="mb-2">NOT CLAIMED (@s.NotClaimed.Count)</MudChip>
                <MudStack Spacing="0">
                    @foreach (var c in s.NotClaimed) { <MudText Typo="Typo.body2">&bull; @c</MudText> }
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<MudText Typo="Typo.h6" GutterBottom="true" Class="mt-4">Key Open Problems</MudText>
<MudGrid Spacing="2">
    @foreach (var p in s.OpenProblems)
    {
        var priC = p.Priority switch { "P1" => Color.Error, "P2" => Color.Warning, _ => Color.Default };
        <MudItem xs="12" md="6" lg="4">
            <MudCard Elevation="1" Class="trm-status-card">
                <MudCardContent>
                    <MudChip T="string" Size="Size.Small" Color="@priC" Variant="Variant.Outlined" Class="mb-1">@p.Priority</MudChip>
                    <MudText Typo="Typo.subtitle2"><b>@p.Title</b></MudText>
                    <MudText Typo="Typo.body2">@p.Description</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@if (!string.IsNullOrEmpty(s.Roadmap.RecommendedTestFile))
{
    <MudText Typo="Typo.h6" GutterBottom="true" Class="mt-4">Roadmap</MudText>
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudText Typo="Typo.subtitle2" GutterBottom="true">Recommended Next Test File</MudText>
        <MudText Typo="Typo.body2" Class="mb-2"><code>@s.Roadmap.RecommendedTestFile</code></MudText>
        <MudText Typo="Typo.subtitle2" GutterBottom="true">Candidate Continuous Coupling Update Laws</MudText>
        <MudStack Spacing="0">
            @foreach (var law in s.Roadmap.CandidateUpdateLaws) { <MudText Typo="Typo.body2"><code>@law</code></MudText> }
        </MudStack>
    </MudPaper>
}

<MudText Typo="Typo.h6" GutterBottom="true" Class="mt-4">Documents</MudText>
<MudGrid Spacing="2">
    @foreach (var doc in s.Documents)
    {
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-3 text-center" Outlined="true">
                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle2" Class="mt-1"><b>@doc.Title</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@doc.Description</MudText>
                @if (doc.Available && doc.Url is not null)
                { <MudButton Href="@doc.Url" Variant="Variant.Outlined" Size="Size.Small" Class="mt-2" Color="Color.Primary" Target="_blank">Open</MudButton> }
                else
                { <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">Document not yet published on website.</MudText> }
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudPaper Class="pa-4 mt-4" Outlined="true" Style="background: var(--mud-palette-success-hover, #E8F5E9); border-left: 4px solid var(--mud-palette-success, #2E7D32);">
    <MudText Typo="Typo.subtitle1" Color="Color.Success"><b>✅ @s.TestSummary.Passed / @s.TestSummary.Total Tests Passing — @s.TestSummary.Verification @s.TestSummary.Date</b></MudText>
    <MudText Typo="Typo.caption">Command: <code>@s.TestSummary.Command</code> · @s.Suites.Count suites · @s.TestSummary.Failed failed · @s.TestSummary.Skipped skipped</MudText>
</MudPaper>
}

@code {
    private TrmStatusModel? _status;
    private bool _loading = true;
    private bool _loadError;
    private string _currentVersionLabel = "";
    private bool _prevDisabled = true;
    private bool _nextDisabled = true;
    private bool _firstDisabled = true;
    private bool _newestDisabled = true;
    private int _sliderIndex;
    private int _sliderMax;
    private bool _sliderUpdating;

    protected override async Task OnInitializedAsync()
    {
        _status = await StatusService.GetStatusAsync();
        _loadError = _status is null;
        _loading = false;
        _sliderMax = Math.Max(0, StatusService.GetAvailableVersions().Count - 1);
        UpdateNavigationState();
    }

    private async Task LoadAndRefresh(string version)
    {
        _loading = true; _loadError = false;
        _status = await StatusService.LoadVersionAsync(version);
        _loadError = _status is null;
        _loading = false;
        UpdateNavigationState();
    }

    private void UpdateNavigationState()
    {
        _currentVersionLabel = StatusService.GetCurrentVersion() ?? "?";
        _prevDisabled = StatusService.GetPreviousVersion() is null;
        _nextDisabled = StatusService.GetNextVersion() is null;
        _firstDisabled = StatusService.GetFirstVersion() == _currentVersionLabel;
        _newestDisabled = StatusService.GetNewestVersion() == _currentVersionLabel;

        // Sync slider without triggering change handler
        if (!_sliderUpdating)
        {
            var versions = StatusService.GetAvailableVersions();
            var idx = versions.IndexOf(_currentVersionLabel ?? "");
            if (idx >= 0) _sliderIndex = idx;
            _sliderMax = Math.Max(0, versions.Count - 1);
        }
    }

    private async Task OnSliderChanged()
    {
        _sliderUpdating = true;
        try
        {
            var versions = StatusService.GetAvailableVersions();
            if (_sliderIndex >= 0 && _sliderIndex < versions.Count)
            {
                var version = versions[_sliderIndex];
                if (version != _currentVersionLabel)
                    await LoadAndRefresh(version);
            }
        }
        finally { _sliderUpdating = false; }
    }

    private async Task GoFirst() { var v = StatusService.GetFirstVersion(); if (v is not null) await LoadAndRefresh(v); }
    private async Task GoPrevious() { var v = StatusService.GetPreviousVersion(); if (v is not null) await LoadAndRefresh(v); }
    private async Task GoNext() { var v = StatusService.GetNextVersion(); if (v is not null) await LoadAndRefresh(v); }
    private async Task GoNewest() { var v = StatusService.GetNewestVersion(); if (v is not null) await LoadAndRefresh(v); }

    private static string GetSuiteDescription(string name) => name switch
    {
        "Emergent Metric" => "Temporal Rate Matrices transformed into logarithmic distance d = -log(R) satisfy metric properties.",
        "Blind Emergent Geometry" => "Geometry reconstructed from oscillator phase dynamics without using graph distance during inference.",
        "Self-Consistent Topology" => "Topology iteratively updated from inferred Temporal Rate Matrices in a convergent loop.",
        "Topology Fixed-Point Robustness" => "Null models, shuffled oscillators, random matrices do not produce same stability signatures.",
        "Quantum Benchmarks" => "Interference, graph uncertainty, discrete spectra, tunneling-like attenuation benchmarked.",
        "Planck Scale Benchmarks" => "Internal TRM scale candidates measured (l_TRM, t_TRM, correlation cutoff, spectral cutoff, causal time).",
        "Dimensional Emergence" => "Spectral/sync diagnostics across graph topologies; correlation analysis.",
        "Natural Continuous Coupling Update" => "Continuous update laws (exp, Gaussian, power-law, softmax) replace kNN topology construction.",
        "Coupling Law Selection" => "Comparison of exponential, Gaussian, power-law, softmax, and adaptive coupling update forms.",
        "Exponential Fixed Point" => "Fixed-point investigation of K_next = K0 * exp(-d/xi); self-consistency and convergence diagnostics.",
        "Exp Fixed-Point Robustness" => "Parameter sweeps (xi, K0, sigma); contraction diagnostic; law comparison; large-N hints.",
        "Fixed-Point Basin Mapping" => "Basin of attraction mapping across initial conditions, perturbations, parameters, and nulls.",
        "Exponential Continuum Scaling" => "Continuum scaling of exponential fixed point up to N=200; sparsity and spectral proxies.",
        "Cross-Law Continuum Scaling" => "Cross-law comparison (exp/gauss/power/softmax/adaptive) across N=40..200; robustness ranking.",
        "Exponential Large-N Scaling" => "Large-N scaling (N=200, 300, 500) with reduced-epoch diagnostics; sampled-pair approximations.",
        "Causal Structure Probe" => "Directed/asymmetric influence probes (lagged R, kick-response delays, causal distance d/tau).",
        "Causal Propagation Speed" => "Propagation speed benchmarks; c_eff_candidate distribution; light-cone-like front diagnostic.",
        "Lorentz Signature Probe" => "Lorentz signature probe; finite-front fits; inside/outside cone; dispersion proxy.",
        "Causal Front Robustness" => "Causal front robustness; event density grid; fit stability; pre-calibration readiness.",
        "Causal Front Param Optimization" => "Parameter optimization; regime ranking; heatmaps; kick linearity; pre-calibration candidates.",
        "Fine Structure Parameter Scan" => "High-resolution xi/K0 scans; band detection; plateau-vs-peak classification.",
        "Fractal Band Structure" => "Multi-resolution grids; box-counting dimensions; self-similarity zoom; SPARC placeholder.",
        "Energy-Load Trampoline Effect" => "Local omega-shift; geometry deformation; remote response; response kernel fits.",
        "Data Discovery" => "Dataset discovery; MRT/DAT parsers; file metadata; catalog building.",
        "SPARC Readiness" => "SPARC file detection; MRT parsing readiness; rotation-curve column detection.",
        "SPARC Residual Structure" => "SPARC MassModels loading; baryonic velocity preview; residual law fits.",
        "Energy-Time-Geometry Coupling" => "Energy→Time→Geometry chain; Load→Ω→R→d→K→remote response diagnostics.",
        "ETG Transfer Functions" => "Transfer functions; slopes, linearity, saturation, chain gain, closure error.",
        "ETG Calibration" => "Transfer coefficient extraction; natural units; calibration matrix.",
        "ETG Dimension Selection" => "D_eff under load; local/global dimension; ETG-dimension correlation.",
        "Dimension Attractor" => "Multiple estimators; N-scaling; law comparison; band relationship.",
        "Dim Estimator Calibration" => "Lattice reference bias; finite-N correction; integer proximity.",
        "Energy-Load Response Kernel" => "Response law comparison; shell data; log-periodic residuals; kernel stability.",
        _ => "Test suite results verified."
    };
}